# Values below target docker compose (service hostnames). Copy to .env and fill secrets.

# Postgres (compose creates user/db app/app/app)
DATABASE_URL=postgresql+psycopg://app:app@postgres:5432/app

# Redis
REDIS_URL=redis://redis:6379/0

# MinIO (S3)
S3_ENDPOINT=http://minio:9000
S3_ACCESS_KEY=minioadmin
S3_SECRET_KEY=minioadmin-change-me
S3_BUCKET=short-video

# LLM (DeepSeek via openai SDK)
DEEPSEEK_API_KEY=
DEEPSEEK_BASE_URL=https://api.deepseek.com
DEEPSEEK_MODEL=deepseek-chat
# Model that accepts images (found by `uv run python -m app.llm.probe`)
DEEPSEEK_VISION_MODEL=deepseek-flash
# 1 = cache LLM responses on disk (.cache/llm-cache) keyed by model + prompt + image hash
LLM_CACHE=0

# TTS (ElevenLabs)
ELEVENLABS_API_KEY=
ELEVENLABS_VOICE_ID_VI=
ELEVENLABS_VOICE_ID_EN=

# Fernet key: python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
CREDENTIAL_ENCRYPTION_KEY=

# Blur e-mails, phone numbers and the account menu on signed-in pages: auto (when a session is held), 1, 0
BLUR_PERSONAL_DATA=auto
# Tests only: open the login window hidden
# LOGIN_BROWSER_HEADLESS=1

# Internal services
RENDER_SERVICE_URL=http://render:3001
BROWSER_CDP_URL=http://browser-vnc:9222

# Public URLs (used by the user's browser)
NOVNC_PUBLIC_URL=http://localhost:6080
NEXT_PUBLIC_API_URL=http://localhost:8000
NEXT_PUBLIC_WS_URL=ws://localhost:8000
