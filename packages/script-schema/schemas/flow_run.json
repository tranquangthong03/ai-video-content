{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "flow_run.json",
  "title": "FlowRun",
  "description": "What the Flow Agent did for one CoreFlow: replayable steps (resolved locators), chapters and the sample data it used.",
  "type": "object",
  "additionalProperties": false,
  "required": ["flow_id", "status", "steps", "chapters"],
  "properties": {
    "flow_id": { "type": "string" },
    "status": { "enum": ["reached_goal", "stopped_before_submit", "partial", "failed"] },
    "steps": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["i", "action"],
        "properties": {
          "i": { "type": "integer", "minimum": 1 },
          "action": { "$ref": "action.json" },
          "locator": { "oneOf": [{ "$ref": "locator.json" }, { "type": "null" }], "default": null, "description": "The spec that resolved when the agent acted; replay copies it into action.locator" },
          "target_text": { "type": ["string", "null"], "default": null },
          "value": { "type": ["string", "null"], "default": null },
          "url_before": { "type": ["string", "null"], "default": null },
          "url_after": { "type": ["string", "null"], "default": null },
          "screenshot": { "type": ["string", "null"], "default": null, "description": "Path (relative to the job dir) of the viewport after the step" },
          "note": { "type": "string", "default": "", "description": "One Vietnamese sentence for the viewer" },
          "chapter_id": { "type": ["string", "null"], "default": null },
          "t_ms_hint": { "type": ["integer", "null"], "minimum": 0, "default": null },
          "blank": { "type": "boolean", "default": false, "description": "The page was still empty after waiting for its content: not a valid storyboard step" },
          "no_effect": { "type": "boolean", "default": false, "description": "The page did not change after this action: not counted in the flow" },
          "flag_reason": { "type": ["string", "null"], "default": null, "description": "blank_page | guard_broke_page | no_effect" }
        }
      }
    },
    "chapters": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["id", "title", "step_ids"],
        "properties": {
          "id": { "type": "string" },
          "title": { "type": "string" },
          "step_ids": { "type": "array", "items": { "type": "integer" } },
          "value_line": { "type": ["string", "null"], "default": null }
        }
      }
    },
    "sample_data": { "type": "object", "default": {} },
    "warnings": { "type": "array", "items": { "type": "string" }, "default": [] },
    "llm_calls": { "type": "integer", "minimum": 0, "default": 0 },
    "submit_policy": { "enum": ["stop", "allow"], "default": "stop" },
    "stop_ref": { "type": ["string", "null"], "default": null, "description": "stopped_before_submit: the button the agent stopped at (step index of its hover)" },
    "live": {
      "oneOf": [
        {
          "type": "object",
          "additionalProperties": false,
          "description": "The film made while the agent ran: one clip, its logs (focus, click, inventory, actions) and what to cut out of it.",
          "required": ["clip", "logs", "content_ms", "start_offset_ms"],
          "properties": {
            "clip": { "type": "string", "description": "Path relative to the job dir" },
            "logs": { "type": "string", "description": "JSON file with focus_log, click_log, inventory, action_log, activity_ms" },
            "content_ms": { "type": "integer", "minimum": 0 },
            "start_offset_ms": { "type": "integer", "minimum": 0, "description": "The loading phase (and the sync pulse) ends here" },
            "sync_offset_ms": { "type": "integer", "default": 0, "description": "video clock = log clock + this" },
            "pulse_at_ms": { "type": "integer", "default": 0 },
            "segments": {
              "type": "array",
              "default": [],
              "items": {
                "type": "object",
                "additionalProperties": false,
                "required": ["from_ms", "to_ms", "kind"],
                "properties": {
                  "from_ms": { "type": "integer", "minimum": 0 },
                  "to_ms": { "type": "integer", "minimum": 0 },
                  "kind": { "enum": ["llm_wait", "retry", "rejected"] },
                  "step": { "type": ["integer", "null"], "default": null },
                  "note": { "type": "string", "default": "" }
                }
              }
            },
            "marks": {
              "type": "array",
              "default": [],
              "items": {
                "type": "object",
                "additionalProperties": false,
                "required": ["i", "start_ms", "end_ms"],
                "properties": {
                  "i": { "type": "integer", "minimum": 1 },
                  "start_ms": { "type": "integer", "minimum": 0 },
                  "end_ms": { "type": "integer", "minimum": 0 }
                }
              }
            }
          }
        },
        { "type": "null" }
      ],
      "default": null
    },
    "env_issues": {
      "type": "array",
      "default": [],
      "description": "Pages that stayed empty because the request guard refused the requests they need (environment, not the site)",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["kind", "blocked_urls", "page_url"],
        "properties": {
          "kind": { "enum": ["guard_broke_page"] },
          "blocked_urls": { "type": "array", "items": { "type": "string" } },
          "page_url": { "type": "string" }
        }
      }
    },
    "give_up": {
      "oneOf": [
        {
          "type": "object",
          "additionalProperties": false,
          "required": ["reason_kind", "reason"],
          "properties": {
            "reason_kind": { "enum": ["no_data", "no_permission", "feature_missing", "blocked_by_site", "stuck", "env_blocked"] },
            "reason": { "type": "string" },
            "quote": { "type": ["string", "null"], "default": null, "description": "The site's own message, word for word" }
          }
        },
        { "type": "null" }
      ],
      "default": null
    },
    "report": {
      "type": ["object", "null"],
      "default": null,
      "additionalProperties": false,
      "description": "How the run went: model, images, calls, tokens, seconds, write requests",
      "properties": {
        "model": { "type": ["string", "null"], "default": null },
        "used_images": { "type": "boolean", "default": false },
        "llm_calls": { "type": "integer", "default": 0 },
        "prompt_tokens": { "type": "integer", "default": 0 },
        "completion_tokens": { "type": "integer", "default": 0 },
        "seconds": { "type": "number", "default": 0 },
        "write_requests": { "type": "array", "items": { "type": "string" }, "default": [] },
        "guard_intents": { "type": "object", "additionalProperties": { "type": "integer" }, "default": {}, "description": "How the guard judged the non-GET requests: read / write / unknown / telemetry" },
        "text_calls": { "type": "integer", "default": 0, "description": "LLM calls made without the screenshot" },
        "vision_calls": { "type": "integer", "default": 0, "description": "LLM calls made with the screenshot" },
        "escalated_because": { "type": ["string", "null"], "default": null, "description": "Why the agent started sending screenshots (vision=auto)" },
        "invented_refs": { "type": "integer", "default": 0, "description": "Actions that named a ref not in the list" },
        "repeat_warnings": { "type": "integer", "default": 0 }
      }
    }
  }
}
