{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "theme.json",
  "title": "Theme",
  "type": "object",
  "additionalProperties": false,
  "required": ["primary", "accent", "font", "motion_preset", "caption_style", "music_mood", "voice_id", "language"],
  "properties": {
    "primary": { "type": "string", "pattern": "^#[0-9a-fA-F]{6}$" },
    "accent": { "type": "string", "pattern": "^#[0-9a-fA-F]{6}$" },
    "font": { "type": "string", "minLength": 1 },
    "logo_asset": { "type": ["string", "null"], "default": null },
    "motion_preset": { "enum": ["energetic", "calm"] },
    "caption_style": { "enum": ["tiktok_bounce", "minimal", "karaoke"] },
    "music_mood": { "enum": ["energetic", "upbeat", "calm", "corporate"] },
    "voice_id": { "type": "string", "minLength": 1 },
    "language": { "enum": ["vi", "en"] }
  }
}
