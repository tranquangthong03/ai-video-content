{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "script.json",
  "title": "Script",
  "type": "object",
  "additionalProperties": false,
  "required": ["title", "goal", "aspect_ratio", "target_duration_s", "headline", "theme", "scenes"],
  "properties": {
    "title": { "type": "string", "minLength": 1 },
    "goal": { "enum": ["awareness", "conversion", "tutorial", "recruitment"] },
    "aspect_ratio": { "const": "9:16" },
    "target_duration_s": { "type": "integer", "minimum": 15, "maximum": 90 },
    "template": { "enum": ["desktop_focus", "desktop_showcase", "phone_showcase"], "default": "desktop_focus" },
    "capture": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "viewport": { "enum": ["desktop", "mobile"], "default": "desktop" },
        "width": { "type": "integer", "minimum": 320, "maximum": 3840, "default": 1440 },
        "height": { "type": "integer", "minimum": 320, "maximum": 3840, "default": 900 }
      },
      "default": { "viewport": "desktop", "width": 1440, "height": 900 }
    },
    "flow_id": { "type": ["string", "null"], "default": null },
    "badge": { "type": ["string", "null"], "maxLength": 24, "default": null },
    "headline": { "type": "string", "minLength": 1, "maxLength": 40 },
    "headline_highlight": { "type": ["string", "null"], "default": null },
    "framework": {
      "enum": ["pain_journey_result", "before_after_bridge", null],
      "default": null,
      "description": "The narrative frame the script follows (PAS shortened for a flow video; before/after/bridge for a one-page tool)"
    },
    "hook_options": {
      "type": "array",
      "maxItems": 2,
      "default": [],
      "description": "Two hooks of different kinds; the hook scene shows the chosen one",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["kind", "voiceover"],
        "properties": {
          "kind": { "enum": ["pain_question", "result_first", "shocking_number", "counterintuitive", "you_are_doing_it_wrong"] },
          "voiceover": { "type": "string", "minLength": 1 },
          "on_screen_text": { "type": ["string", "null"], "default": null }
        }
      }
    },
    "theme": { "$ref": "theme.json" },
    "scenes": { "type": "array", "items": { "$ref": "scene.json" }, "minItems": 3, "maxItems": 6 }
  }
}
