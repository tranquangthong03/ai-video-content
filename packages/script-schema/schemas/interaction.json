{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "interaction.json",
  "title": "InteractionRequest",
  "type": "object",
  "additionalProperties": false,
  "required": ["interaction_id", "job_id", "kind", "message", "allowed_actions"],
  "properties": {
    "interaction_id": { "type": "string" },
    "job_id": { "type": "string" },
    "kind": {
      "enum": [
        "clarify", "login_required", "script_review", "video_review",
        "confirm_understanding", "select_features", "choose_concept", "outline_review",
        "select_flow", "flow_storyboard_review", "marketing_brief"
      ]
    },
    "message": { "type": "string" },
    "questions": {
      "type": "array",
      "default": [],
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["id", "text", "type"],
        "properties": {
          "id": { "type": "string" },
          "text": { "type": "string" },
          "type": { "enum": ["single", "multi", "text"] },
          "options": {
            "type": "array",
            "default": [],
            "items": {
              "type": "object",
              "additionalProperties": false,
              "required": ["id", "label"],
              "properties": {
                "id": { "type": "string" },
                "label": { "type": "string" },
                "description": { "type": ["string", "null"], "default": null }
              }
            }
          },
          "allow_custom": { "type": "boolean", "default": false }
        }
      }
    },
    "script_version": { "type": ["integer", "null"], "default": null },
    "summary": {
      "type": ["array", "null"],
      "default": null,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["scene_id", "one_liner"],
        "properties": {
          "scene_id": { "type": "string" },
          "one_liner": { "type": "string" }
        }
      }
    },
    "changes": { "type": ["array", "null"], "items": { "type": "string" }, "default": null },
    "live_login_url": { "type": ["string", "null"], "default": null },
    "video_url": { "type": ["string", "null"], "default": null },
    "allowed_actions": { "type": "array", "items": { "type": "string" } },
    "profile": { "oneOf": [{ "$ref": "product_profile.json" }, { "type": "null" }], "default": null },
    "concepts": {
      "type": ["array", "null"],
      "items": { "$ref": "video_concept.json" },
      "default": null
    },
    "outline": { "oneOf": [{ "$ref": "outline.json" }, { "type": "null" }], "default": null },
    "login": {
      "oneOf": [
        {
          "type": "object",
          "additionalProperties": false,
          "description": "login_required: where the sign-in page is, why we ask and how the user can answer.",
          "required": ["reason", "methods"],
          "properties": {
            "login_url": { "type": ["string", "null"], "default": null },
            "target_url": { "type": ["string", "null"], "default": null },
            "reason": { "type": "string" },
            "methods": {
              "type": "array",
              "items": { "enum": ["browser_window", "credentials", "upload_state", "public"] }
            },
            "can_enter_url": { "type": "boolean", "default": false },
            "failure": { "type": ["string", "null"], "default": null },
            "hint": { "type": ["string", "null"], "default": null }
          }
        },
        { "type": "null" }
      ],
      "default": null
    },
    "flows": {
      "type": ["array", "null"],
      "items": { "$ref": "core_flow.json" },
      "default": null,
      "description": "select_flow: the proposed flows; answers.selected_flows is the ordered id list"
    },
    "flow_select": {
      "oneOf": [
        {
          "type": "object",
          "additionalProperties": false,
          "required": ["max", "default"],
          "properties": {
            "max": { "type": "integer" },
            "default": { "type": "array", "items": { "type": "string" } },
            "submit_blocked_reason": { "type": ["string", "null"], "default": null, "description": "Set when the site is a shared demo: allowing submit is refused" },
            "infeasible": {
              "type": "object",
              "additionalProperties": { "type": "string" },
              "default": {},
              "description": "flow id -> the site's own message: this flow cannot be done with this account"
            },
            "quality": {
              "type": "object",
              "additionalProperties": { "$ref": "flow_quality.json" },
              "default": {},
              "description": "flow id -> how many steps make something visible appear (value_actions) and the label when it is too few"
            },
            "empty_warning": {
              "type": ["string", "null"],
              "default": null,
              "description": "Set when the explored pages show the account has no data (two or more signs)"
            },
            "env_warning": {
              "type": ["string", "null"],
              "default": null,
              "description": "Set when a page stayed empty because the request guard refused its requests"
            }
          }
        },
        { "type": "null" }
      ],
      "default": null
    },
    "flow_review": {
      "oneOf": [{ "$ref": "flow_run.json" }, { "type": "null" }],
      "default": null,
      "description": "flow_storyboard_review: the run to look at (steps carry screenshot paths)"
    },
    "flow_quality": {
      "oneOf": [{ "$ref": "flow_quality.json" }, { "type": "null" }],
      "default": null,
      "description": "flow_storyboard_review: is the run worth filming (value actions, empty pages)"
    },
    "brief_form": {
      "oneOf": [
        {
          "type": "object",
          "additionalProperties": false,
          "description": "marketing_brief: ideas to pick from, a note, and the brief given so far (if any). The answer is UserResponse.brief.",
          "required": ["suggestions", "note"],
          "properties": {
            "suggestions": { "$ref": "brief_suggestions.json" },
            "note": { "type": "string" },
            "draft": { "oneOf": [{ "$ref": "marketing_brief.json" }, { "type": "null" }], "default": null }
          }
        },
        { "type": "null" }
      ],
      "default": null
    },
    "selection": {
      "oneOf": [
        {
          "type": "object",
          "additionalProperties": false,
          "description": "select_features: the profile's features are the choices; answers.selected_features is the ordered id list.",
          "required": ["min", "max", "default"],
          "properties": {
            "min": { "type": "integer" },
            "max": { "type": "integer" },
            "recommended_max": { "type": "integer", "default": 3 },
            "default": { "type": "array", "items": { "type": "string" } },
            "new_ids": { "type": "array", "items": { "type": "string" }, "default": [] }
          }
        },
        { "type": "null" }
      ],
      "default": null
    }
  }
}
