{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "outline.json",
  "title": "Outline",
  "type": "object",
  "additionalProperties": false,
  "required": ["concept_id", "title", "goal", "duration_s", "feature_ids", "beats"],
  "properties": {
    "concept_id": { "type": "string" },
    "title": { "type": "string", "minLength": 1 },
    "goal": { "enum": ["awareness", "conversion", "tutorial", "recruitment"] },
    "duration_s": { "enum": [30, 45, 60] },
    "feature_ids": { "type": "array", "items": { "type": "string" } },
    "version": { "type": "integer", "minimum": 1, "default": 1 },
    "beats": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["id", "text"],
        "properties": {
          "id": { "type": "string", "pattern": "^b[0-9]+$" },
          "text": { "type": "string", "minLength": 1 },
          "feature_id": { "type": ["string", "null"], "default": null }
        }
      }
    }
  }
}
