{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "product_profile.json",
  "title": "ProductProfile",
  "type": "object",
  "additionalProperties": false,
  "required": ["site_type", "product_name", "one_liner", "target_users", "features"],
  "properties": {
    "site_type": { "enum": ["landing", "web_app", "ecommerce", "tool", "content"] },
    "product_name": { "type": "string", "minLength": 1 },
    "one_liner": { "type": "string" },
    "target_users": { "type": "array", "items": { "type": "string" } },
    "value_props": { "type": "array", "items": { "type": "string" }, "default": [] },
    "features": { "type": "array", "items": { "$ref": "#/$defs/Feature" }, "maxItems": 12 },
    "open_questions": { "type": "array", "items": { "type": "string" }, "default": [] }
  },
  "$defs": {
    "Evidence": {
      "type": "object",
      "additionalProperties": false,
      "required": ["source", "url"],
      "properties": {
        "source": {
          "enum": ["landing_hero", "landing_features", "pricing", "nav", "app_action", "docs", "landing_claim"]
        },
        "url": { "type": "string" },
        "ref": { "type": ["string", "null"], "default": null },
        "quote": { "type": ["string", "null"], "default": null }
      }
    },
    "DemoStep": {
      "type": "object",
      "additionalProperties": false,
      "required": ["do"],
      "properties": {
        "do": { "enum": ["goto", "click", "type", "scroll", "hover", "wait", "upload", "dblclick", "right_click"] },
        "url": { "type": ["string", "null"], "default": null },
        "ref": { "type": ["string", "null"], "default": null },
        "text": { "type": ["string", "null"], "default": null },
        "file": { "type": ["string", "null"], "default": null, "description": "Sample file name for do=upload" },
        "locator": { "oneOf": [{ "$ref": "locator.json" }, { "type": "null" }], "default": null, "description": "Filled by code from the element behind ref" }
      }
    },
    "DemoEvidence": {
      "type": "object",
      "additionalProperties": false,
      "required": ["url_changed", "dom_delta", "new_dialog", "new_list_items", "visual_diff"],
      "properties": {
        "url_changed": { "type": "boolean" },
        "dom_delta": { "type": "integer" },
        "new_dialog": { "type": "boolean" },
        "new_list_items": { "type": "integer" },
        "visual_diff": { "type": "number" },
        "target_page_type": { "type": ["string", "null"], "default": null },
        "notes": { "type": "string", "default": "" }
      }
    },
    "ShowcaseTarget": {
      "type": "object",
      "additionalProperties": false,
      "required": ["url", "text_quote"],
      "properties": {
        "url": { "type": "string" },
        "selector": { "type": ["string", "null"], "default": null },
        "ref": { "type": ["string", "null"], "default": null },
        "text_quote": { "type": "string" }
      }
    },
    "Feature": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "name", "description", "evidence", "importance"],
      "properties": {
        "id": { "type": "string", "minLength": 1 },
        "name": { "type": "string", "minLength": 1 },
        "description": { "type": "string" },
        "evidence": { "type": "array", "items": { "$ref": "#/$defs/Evidence" } },
        "importance": { "type": "number", "minimum": 0, "maximum": 1 },
        "demo_steps": { "type": "array", "items": { "$ref": "#/$defs/DemoStep" }, "default": [] },
        "demo_kind": {
          "oneOf": [{ "enum": ["interaction", "navigation", "showcase", "failed"] }, { "type": "null" }],
          "default": null,
          "description": "null = not verified"
        },
        "demo_score": { "type": "number", "minimum": 0, "maximum": 1, "default": 0, "description": "Confidence of the demo_kind verdict" },
        "demo_evidence": { "oneOf": [{ "$ref": "#/$defs/DemoEvidence" }, { "type": "null" }], "default": null },
        "showcase_target": { "oneOf": [{ "$ref": "#/$defs/ShowcaseTarget" }, { "type": "null" }], "default": null },
        "requires_setup": {
          "type": "boolean",
          "default": false,
          "description": "Only visible after earlier steps created some data; demo_steps then start with those setup steps"
        },
        "verified": { "type": "boolean", "default": false },
        "demo_note": { "type": ["string", "null"], "default": null },
        "thumbnail": { "type": ["string", "null"], "default": null },
        "source": { "enum": ["site", "user"], "default": "site" }
      }
    }
  }
}
