{
  "name": "short-video-ai",
  "version": "0.1.0",
  "private": true,
  "packageManager": "pnpm@12.15.0",
  "scripts": {
    "dev:api": "cd services/api && uv run uvicorn app.api.main:app --port 8000",
    "dev:web": "pnpm --filter web dev",
    "dev:all": "concurrently -k -n api,web -c blue,green \"pnpm dev:api\" \"pnpm dev:web\""
  },
  "devDependencies": {
    "concurrently": "^10.0.6"
  }
}
